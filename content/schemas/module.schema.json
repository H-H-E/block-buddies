{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block-buddies/module.schema.json",
  "title": "Block Buddies Module",
  "type": "object",
  "required": [
    "$schema",
    "id",
    "revision",
    "status",
    "title",
    "shortChildTitle",
    "ageBand",
    "durationMinutes",
    "outcome",
    "optionalConnections",
    "editions",
    "platforms",
    "inputMethods",
    "testedVersions",
    "deliveryModes",
    "multiplayerRequirements",
    "knownIncompatibilities",
    "prerequisites",
    "interests",
    "setup",
    "flow",
    "mentorScript",
    "learnerCues",
    "mediaReferences",
    "sharedRoles",
    "childChoicePoints",
    "commonProblems",
    "hintLadder",
    "resetPath",
    "soloFallback",
    "evidenceOptions",
    "accessibilityOptions",
    "safetyRequirements",
    "parentSummaryTemplate",
    "nextModules",
    "review"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "needs-assets",
        "needs-review",
        "published"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "shortChildTitle": {
      "type": "string",
      "minLength": 2
    },
    "ageBand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "target"
      ],
      "properties": {
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "target": {
          "type": "integer"
        }
      }
    },
    "durationMinutes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      }
    },
    "outcome": {
      "type": "string",
      "minLength": 15,
      "description": "Primary Minecraft outcome - what the child makes or can do in the game"
    },
    "optionalConnections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional academic/technical tags; never gates"
    },
    "editions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "bedrock",
          "java"
        ]
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "inputMethods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "touch",
          "controller",
          "keyboard-mouse"
        ]
      }
    },
    "testedVersions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "deliveryModes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "solo_guided",
          "shared_world"
        ]
      }
    },
    "multiplayerRequirements": {
      "type": "string"
    },
    "knownIncompatibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guardianSteps",
        "mentorPreflight"
      ],
      "properties": {
        "guardianSteps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "mentorPreflight": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "flow": {
      "type": "array",
      "minItems": 6,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "minutes",
          "mentorMoves",
          "childAction"
        ],
        "properties": {
          "phase": {
            "type": "string"
          },
          "minutes": {
            "type": "string"
          },
          "mentorMoves": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "childAction": {
            "type": "string"
          }
        }
      }
    },
    "mentorScript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openingLines",
        "keyPhrases"
      ],
      "properties": {
        "openingLines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "keyPhrases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "learnerCues": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cueText",
          "action"
        ],
        "properties": {
          "cueText": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "iconHint": {
            "type": "string"
          }
        }
      }
    },
    "mediaReferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sharedRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "childRole",
        "mentorRole",
        "rotationNotes"
      ],
      "properties": {
        "childRole": {
          "type": "string"
        },
        "mentorRole": {
          "type": "string"
        },
        "rotationNotes": {
          "type": "string"
        }
      }
    },
    "childChoicePoints": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt",
          "options"
        ],
        "properties": {
          "prompt": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "commonProblems": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "problem",
          "fix"
        ],
        "properties": {
          "problem": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "hintLadder": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "resetPath": {
      "type": "string"
    },
    "soloFallback": {
      "type": "string"
    },
    "evidenceOptions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "enum": [
          "screenshot",
          "spoken-description",
          "pointing",
          "demonstration",
          "artifact-photo"
        ]
      }
    },
    "accessibilityOptions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "safetyRequirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "parentSummaryTemplate": {
      "type": "string"
    },
    "nextModules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playtested",
        "lastReviewed",
        "notes"
      ],
      "properties": {
        "playtested": {
          "type": "boolean"
        },
        "lastReviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "worldSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "description"
      ],
      "properties": {
        "mode": {
          "enum": [
            "flat-creative",
            "prepared-world",
            "survival-easy"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  }
}